{
  "name": "math-racer-3d",
  "version": "1.0.0",
  "description": "3D 数学赛车游戏 — 两位数加减练习 + 车库改装",
  "private": true,
  "scripts": {
    "build": "esbuild js/main.js --bundle --format=iife --minify --charset=utf8 --target=es2019 --outfile=dist/game.bundle.js",
    "watch": "esbuild js/main.js --bundle --format=iife --charset=utf8 --target=es2019 --outfile=dist/game.bundle.js --watch",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "three": "^0.160.0"
  }
}
